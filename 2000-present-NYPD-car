import json
import argparse

with open("nypd_vehicles.json", "r", encoding="utf-8") as f:
    VEHICLES = json.load(f)

def list_all():
    print("--- NYPD Fleet 2000-2026 ---\n")
    for v in VEHICLES:
        print(f"[{v['id']}] {v['name']} ({v['years']})")
        print(f"  > {v['type']} | {v['role']}\n")

def identify(query):
    query = query.lower()
    for v in VEHICLES:
        if query in v['name'].lower() or query in v['id'].lower() or query in v['years']:
            print(f"\n✅ Trouvé: {v['name']}")
            print(f"Années: {v['years']}")
            print(f"Type: {v['type']}")
            print(f"Rôle: {v['role']}")
            print(f"Livrée: {v['livery']}")
            return
    print("❌ Véhicule non trouvé. Essaie: crown, charger, explorer, impala, tahoe")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="NYPD Vehicle Identifier")
    parser.add_argument("--find", type=str, help="Cherche un véhicule (ex: charger, explorer, 2005)")
    args = parser.parse_args()

    if args.find:
        identify(args.find)
    else:
        list_all()
